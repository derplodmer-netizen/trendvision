# Copy to .env on the server. Never commit .env.
BOT_TOKEN=
RESERVE_BOT_USERNAME=
DATABASE_URL=sqlite+aiosqlite:///data/bdxsignal.db

# BinoDex partner smart link (add {tg_id} / {tag} only if the cabinet supports sub-parameters)
REF_URL=https://bdclick.app/smart/ZYwT6O
TRADE_URL=
MIN_DEPOSIT_USD=10

# Partner API key (binp_...): confirms that an account is ours and has a deposit. Server only.
PARTNER_API_KEY=
RECHECK_RECENT_MIN=10
RECHECK_ALL_HOURS=3

# Signals on request: pair (or auto) + expiry chosen by the user
SIGNAL_EXPIRIES=30,60,120,300
SIGNAL_VALID_SEC=30
SIGNAL_MIN_STRENGTH=0.35
SIGNAL_MIN_PAYOUT=80
SIGNAL_OTC=all
SIGNAL_PAIRS_SHOWN=8

# Broadcast of strong entries (users can switch notifications off)
BROADCAST_ENABLED=true
BROADCAST_MIN_STRENGTH=0.6
BROADCAST_EXPIRY_SEC=60
BROADCAST_PER_DAY=4
BROADCAST_GAP_MIN=90
PUSH_PER_DAY=5
QUIET_FROM=23:00
QUIET_TO=09:00
TZ=Europe/Kyiv

# Optional postbacks, if the BinoDex cabinet has them: https://<host>/pb/<POSTBACK_SECRET>?event=...
POSTBACK_SECRET=
CPA_USD=0

ADMIN_TOKEN=
SUPPORT_URL=
VIDEO_HOWTO_URL=
VIDEO_NEW_ACCOUNT_URL=
HTTP_PORT=8080

# Subscription gate: public channel @username; the bot must be an admin there. Empty = no gate.
CHANNEL_URL=
CHANNEL=

# Test accounts (no real registration): ID:reg = registered without deposit, ID:dep = with deposit.
# Also enables /reset. Leave empty in production.
TEST_ACCOUNTS=
